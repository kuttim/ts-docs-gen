{
  "name": "@kuttim/ts-docs-gen",
  "version": "2.0.0",
  "description": "A documentation generation tool for TypeScript projects.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "bin/ts-docs-gen.js"
  ],
  "scripts": {
    "test": "jest",
    "start": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "bin": {
    "ts-docs-gen": "bin/ts-docs-gen.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuttim/ts-docs-gen.git"
  },
  "keywords": [
    "documentation",
    "TypeScript",
    "generator",
    "cli",
    "markdown",
    "docusaurus",
    "mkdocs",
    "jsdoc"
  ],
  "author": "Mikk Küttim",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kuttim/ts-docs-gen/issues"
  },
  "homepage": "https://github.com/kuttim/ts-docs-gen#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "minimatch": "^10.2.6",
    "ts-morph": "^28.0.0"
  }
}
